}

type AuditLog struct {
	ID          int    `json:"id"`
	Timestamp   string `json:"timestamp"`
	MemberNo    string `json:"memberNo"`
	MemberName  string `json:"memberName"`
	Channel     string `json:"channel"`
	Destination string `json:"destination"`
	RenamedFile string `json:"renamedFile"`
	Status      string `json:"status"`
}

const dbPath = "nssf_dispatch.db"

func runSQL(query string) (string, error) {
	cmd := exec.Command("sqlite3", "-json", dbPath, query)
	out, err := cmd.CombinedOutput()
	if err != nil {
		return "", fmt.Errorf("sqlite error: %v - %s", err, string(out))
	}
	return strings.TrimSpace(string(out)), nil
}

func InitDB() error {
	schema := `
	CREATE TABLE IF NOT EXISTS settings (
		key TEXT PRIMARY KEY,
		value TEXT NOT NULL
	);
	CREATE TABLE IF NOT EXISTS audit_logs (
		id INTEGER PRIMARY KEY AUTOINCREMENT,
		timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
		member_no TEXT NOT NULL,
		member_name TEXT NOT NULL,
		channel TEXT NOT NULL,
		destination TEXT NOT NULL,
		renamed_file TEXT NOT NULL,
		status TEXT NOT NULL
	);
	INSERT OR IGNORE INTO settings (key, value) VALUES
		('smtpHost', 'smtp.nssfkenya.co.ke'),
		('smtpPort', '587'),
		('smtpUser', 'statements@nssfkenya.co.ke'),
		('smtpPass', ''),
		('smtpFrom', 'NSSF Kenya Member Services <statements@nssfkenya.co.ke>'),
		('emailEnabled', 'true'),
		('whatsappEnabled', 'true'),
		('whatsappBridge', 'http://127.0.0.1:8095'),
		('whatsappPaired', 'false');
	`
	_, err := runSQL(schema)
	return err
}

func esc(s string) string {
	return strings.ReplaceAll(s, "'", "''")
}

func GetSettings() (AppSettings, error) {
	raw, err := runSQL("SELECT key, value FROM settings;")
	if err != nil {
		return AppSettings{}, err
	}
	var rows []struct {
		Key   string `json:"key"`
		Value string `json:"value"`
	}
	if raw != "" {
		_ = json.Unmarshal([]byte(raw), &rows)
	}
	m := map[string]string{}
	for _, r := range rows {
		m[r.Key] = r.Value
	}
	return AppSettings{
		SMTPHost:        m["smtpHost"],
		SMTPPort:        m["smtpPort"],
		SMTPUser:        m["smtpUser"],
		SMTPPass:        m["smtpPass"],
		SMTPFrom:        m["smtpFrom"],
		EmailEnabled:    m["emailEnabled"] == "true",
		WhatsAppEnabled: m["whatsappEnabled"] == "true",
		WhatsAppBridge:  m["whatsappBridge"],
		WhatsAppPaired:  m["whatsappPaired"] == "true",
	}, nil
}

func SaveSettings(s AppSettings) error {
	pairs := map[string]string{
		"smtpHost":        s.SMTPHost,
		"smtpPort":        s.SMTPPort,
		"smtpUser":        s.SMTPUser,
		"smtpPass":        s.SMTPPass,
		"smtpFrom":        s.SMTPFrom,
		"emailEnabled":    fmt.Sprintf("%v", s.EmailEnabled),
		"whatsappEnabled": fmt.Sprintf("%v", s.WhatsAppEnabled),
		"whatsappBridge":  s.WhatsAppBridge,
		"whatsappPaired":  fmt.Sprintf("%v", s.WhatsAppPaired),
	}
	var sb strings.Builder
	for k, v := range pairs {
		fmt.Fprintf(&sb, "INSERT OR REPLACE INTO settings (key, value) VALUES ('%s', '%s');\n", esc(k), esc(v))
	}
	_, err := runSQL(sb.String())
	return err
}

func InsertAuditLog(memberNo, memberName, channel, dest, filename, status string) error {
	q := fmt.Sprintf(`INSERT INTO audit_logs (member_no, member_name, channel, destination, renamed_file, status)
		VALUES ('%s', '%s', '%s', '%s', '%s', '%s');`,
		esc(memberNo), esc(memberName), esc(channel), esc(dest), esc(filename), esc(status))
	_, err := runSQL(q)
	return err
}

func GetAuditLogs() ([]AuditLog, error) {
	raw, err := runSQL(`SELECT id, timestamp, member_no as memberNo, member_name as memberName,
		channel, destination, renamed_file as renamedFile, status
		FROM audit_logs ORDER BY id DESC LIMIT 50;`)
	if err != nil {
		return nil, err
	}
	var logs []AuditLog
	if raw != "" {
		_ = json.Unmarshal([]byte(raw), &logs)
	}
	return logs, nil
}

