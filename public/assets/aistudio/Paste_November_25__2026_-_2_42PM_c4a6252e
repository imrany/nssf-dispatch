#### `cmd/server/pdf_engine.go` — Validation & Password Encryption

Based on your uploaded sample statement (`getjobid21495.pdf`), the parser extracts `NSSF Member No` (`205819800X`), `Member Name` (`Nyawanda Janet Rose`), and `Id Card No` (`8534562`), and encrypts the PDF using the member's ID Card Number.

```go
package main

import (
	"bytes"
	"compress/zlib"
	"crypto/md5"
	"crypto/rand"
	"crypto/rc4"
	"encoding/hex"
	"errors"
	"fmt"
	"io"
	"regexp"
	"strings"
)

type StatementMeta struct {
	MemberNo   string `json:"memberNo"`
	MemberName string `json:"memberName"`
	IDCardNo   string `json:"idCardNo"`
	Period     string `json:"period"`
	TotalAmt   string `json:"totalAmount"`
}

// ExtractAndValidatePDF decompresses PDF streams using standard library zlib
// and validates the embedded NSSF Member Number against staff input.
func ExtractAndValidatePDF(pdfBytes []byte, expectedMemberNo string) (*StatementMeta, error) {
	var extractedText strings.Builder

	// Locate all stream ... endstream blocks
	streamStart := []byte("stream")
	streamEnd := []byte("endstream")
	idx := 0

	for idx < len(pdfBytes) {
		s := bytes.Index(pdfBytes[idx:], streamStart)
		if s == -1 {
			break
		}
		s += idx + len(streamStart)
		// Skip CRLF or LF after "stream"
		if s < len(pdfBytes) && pdfBytes[s] == '\r' {
			s++
		}
		if s < len(pdfBytes) && pdfBytes[s] == '\n' {
			s++
		}

		e := bytes.Index(pdfBytes[s:], streamEnd)
		if e == -1 {
			break
		}
		rawStream := bytes.TrimSpace(pdfBytes[s : s+e])
		idx = s + e + len(streamEnd)

		// Attempt zlib decompression (FlateDecode)
		zr, err := zlib.NewReader(bytes.NewReader(rawStream))
		if err == nil {
			decompressed, err := io.ReadAll(zr)
			zr.Close()
			if err == nil {
				extractedText.Write(decompressed)
				extractedText.WriteByte('\n')
			}
		}
	}

	// Extract parenthesized PDF text operators: (Text) Tj / TJ
	reText := regexp.MustCompile(`\(([^()\\]*(?:\\.[^()\\]*)*)\)`)
	matches := reText.FindAllStringSubmatch(extractedText.String(), -1)
	var cleanTokens []string
	for _, m := range matches {
		token := strings.TrimSpace(m[1])
		if token != "" {
			cleanTokens = append(cleanTokens, token)
		}
	}
	fullText := strings.Join(cleanTokens, " ")

	meta := &StatementMeta{
		MemberNo:   findField(fullText, `NSSF Member No:\s*([A-Z0-9]+)`),
		MemberName: findField(fullText, `Member Name:\s*([A-Za-z\s]+?)\s*(?:KRA Pin|Date of Birth)`),
		IDCardNo:   findField(fullText, `Id Card No:\s*([0-9]+)`),
		Period:     findField(fullText, `Period From\s*([0-9/]+\s*until\s*[0-9/]+)`),
		TotalAmt:   findField(fullText, `Total Amount:\s*([0-9,]+\.[0-9]{2})`),
	}

	if meta.MemberNo == "" {
		return nil, errors.New("could not read NSSF Member Number from uploaded PDF")
	}
	if !strings.EqualFold(strings.TrimSpace(meta.MemberNo), strings.TrimSpace(expectedMemberNo)) {
		return nil, fmt.Errorf("validation failed: entered NSSF No (%s) does not match statement (%s)", expectedMemberNo, meta.MemberNo)
	}
	if meta.IDCardNo == "" {
		return nil, errors.New("member ID Card Number missing in statement; cannot generate password")
	}

	return meta, nil
}

func findField(corpus, pattern string) string {
	re := regexp.MustCompile(pattern)
	m := re.FindStringSubmatch(corpus)
	if len(m) > 1 {
		return strings.TrimSpace(m[1])
	}
	return ""
}

// PDF Standard Encryption Padding (ISO 32000-1 Algorithm 2)
var pdfPadding = []byte{
	0x28, 0xBF, 0x4E, 0x5E, 0x4E, 0x75, 0x8A, 0x41,
	0x64, 0x00, 0x4E, 0x56, 0xFF, 0xFA, 0x01, 0x08,
	0x2E, 0x2E, 0x00, 0xB6, 0xD0, 0x68, 0x3E, 0x80,
	0x2F, 0x0C, 0xA9, 0xFE, 0x64, 0x53, 0x69, 0x7A,
}

func padPassword(pwd string) []byte {
	out := make([]byte, 32)
	b := []byte(pwd)
	if len(b) >= 32 {
		copy(out, b[:32])
	} else {
		copy(out, b)
		copy(out[len(b):], pdfPadding[:32-len(b)])
	}
	return out
}

// EncryptPDFWithPassword applies PDF 1.4 Standard Security Handler (RC4 128-bit)
// using the member's ID Card Number as the open password.
func EncryptPDFWithPassword(pdfBytes []byte, userPassword string) ([]byte, error) {
	fileID := make([]byte, 16)
	if _, err := rand.Read(fileID); err != nil {
		return nil, err
	}

	ownerPad := padPassword("NSSF_ADMIN_VAULT_2026")
	userPad := padPassword(userPassword)

	// Compute O (Owner) Entry (Rev 3)
	h := md5.Sum(ownerPad)
	for i := 0; i < 50; i++ {
		h = md5.Sum(h[:])
	}
	ownerKey := h[:16]
	oVal := make([]byte, 32)
	copy(oVal, userPad)
	for i := 0; i < 20; i++ {
		tempKey := make([]byte, 16)
		for j := 0; j < 16; j++ {
			tempKey[j] = ownerKey[j] ^ byte(i)
		}
		cipher, _ := rc4.NewCipher(tempKey)
		cipher.XORKeyStream(oVal, oVal)
	}

	// Permissions: Print allowed (-3904 -> 0xFFFFF0C0)
	perm := []byte{0xC0, 0xF0, 0xFF, 0xFF}

	// Compute File Encryption Key (Rev 3)
	hasher := md5.New()
	hasher.Write(userPad)
	hasher.Write(oVal)
	hasher.Write(perm)
	hasher.Write(fileID)
	encKey := hasher.Sum(nil)
	for i := 0; i < 50; i++ {
		sum := md5.Sum(encKey[:16])
		encKey = sum[:16]
	}

	// Compute U (User) Entry (Rev 3)
	uHash := md5.New()
	uHash.Write(pdfPadding)
	uHash.Write(fileID)
	uVal := uHash.Sum(nil)
	for i := 0; i < 20; i++ {
		tempKey := make([]byte, 16)
		for j := 0; j < 16; j++ {
			tempKey[j] = encKey[j] ^ byte(i)
		}
		cipher, _ := rc4.NewCipher(tempKey)
		cipher.XORKeyStream(uVal, uVal)
	}
	uFull := append(uVal, make([]byte, 16)...)

	// Encrypt all indirect streams in-place
	var out bytes.Buffer
	streamStart := []byte("stream")
	streamEnd := []byte("endstream")
	objHeaderRe := regexp.MustCompile(`(\d+)\s+(\d+)\s+obj`)

	pos := 0
	for pos < len(pdfBytes) {
		s := bytes.Index(pdfBytes[pos:], streamStart)
		if s == -1 {
			out.Write(pdfBytes[pos:])
			break
		}
		absStreamKeyword := pos + s
		// Look backwards for "N G obj"
		lookbackStart := absStreamKeyword - 300
		if lookbackStart < pos {
			lookbackStart = pos
		}
		objMatches := objHeaderRe.FindAllSubmatch(pdfBytes[lookbackStart:absStreamKeyword], -1)

		dataStart := absStreamKeyword + len(streamStart)
		if dataStart < len(pdfBytes) && pdfBytes[dataStart] == '\r' {
			dataStart++
		}
		if dataStart < len(pdfBytes) && pdfBytes[dataStart] == '\n' {
			dataStart++
		}

		e := bytes.Index(pdfBytes[dataStart:], streamEnd)
		if e == -1 {
			out.Write(pdfBytes[pos:])
			break
		}
		dataEnd := dataStart + e
		// Trim trailing newline before endstream
		actualEnd := dataEnd
		if actualEnd > dataStart && pdfBytes[actualEnd-1] == '\n' {
			actualEnd--
		}
		if actualEnd > dataStart && pdfBytes[actualEnd-1] == '\r' {
			actualEnd--
		}

		out.Write(pdfBytes[pos:dataStart])
		streamBytes := make([]byte, actualEnd-dataStart)
		copy(streamBytes, pdfBytes[dataStart:actualEnd])

		if len(objMatches) > 0 {
			last := objMatches[len(objMatches)-1]
			var objNum, genNum int
			fmt.Sscanf(string(last[1]), "%d", &objNum)
			fmt.Sscanf(string(last[2]), "%d", &genNum)

			// Per-object RC4 key derivation
			objKeyInput := append([]byte{}, encKey[:16]...)
			objKeyInput = append(objKeyInput, byte(objNum), byte(objNum>>8), byte(objNum>>16), byte(genNum), byte(genNum>>8))
			objHash := md5.Sum(objKeyInput)
			cipher, _ := rc4.NewCipher(objHash[:16])
			cipher.XORKeyStream(streamBytes, streamBytes)
		}

		out.Write(streamBytes)
		out.Write(pdfBytes[actualEnd:dataEnd])
		pos = dataEnd
	}

	// Append Incremental Update with /Encrypt Dictionary
	finalBytes := out.Bytes()
	startXrefIdx := bytes.LastIndex(finalBytes, []byte("startxref"))
	if startXrefIdx == -1 {
		return nil, errors.New("malformed PDF: missing startxref")
	}
	var prevXref int
	fmt.Sscanf(string(finalBytes[startXrefIdx+9:]), "%d", &prevXref)

	sizeRe := regexp.MustCompile(`/Size\s+(\d+)`)
	sizeMatch := sizeRe.FindSubmatch(finalBytes[startXrefIdx-400:])
	nextObjNum := 99
	if len(sizeMatch) > 1 {
		fmt.Sscanf(string(sizeMatch[1]), "%d", &nextObjNum)
	}

	var inc bytes.Buffer
	inc.Write(finalBytes)
	encObjOffset := inc.Len()
	fmt.Fprintf(&inc, "\n%d 0 obj\n<< /Filter /Standard /V 2 /R 3 /Length 128 /P -3904 /O <%s> /U <%s> >>\nendobj\n",
		nextObjNum, strings.ToUpper(hex.EncodeToString(oVal)), strings.ToUpper(hex.EncodeToString(uFull)))

	xrefOffset := inc.Len()
	fmt.Fprintf(&inc, "xref\n%d 1\n%010d 00000 n \n", nextObjNum, encObjOffset)
	fmt.Fprintf(&inc, "trailer\n<< /Size %d /Root 1 0 R /Encrypt %d 0 R /ID [<%s><%s>] /Prev %d >>\nstartxref\n%d\n%%%%EOF\n",
		nextObjNum+1, nextObjNum, hex.EncodeToString(fileID), hex.EncodeToString(fileID), prevXref, xrefOffset)

	return inc.Bytes(), nil
}

