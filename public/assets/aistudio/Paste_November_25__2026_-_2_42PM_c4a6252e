```go
package main

import (
	"embed"
	"encoding/json"
	"fmt"
	"io"
	"io/fs"
	"log"
	"net/http"
	"strings"
	"time"
)

//go:embed dist/*
var embeddedFrontend embed.FS

func main() {
	if err := InitDB(); err != nil {
		log.Fatalf("Database init failed: %v", err)
	}

	mux := http.NewServeMux()

	// Validate & Dispatch Endpoint
	mux.HandleFunc("/api/dispatch", func(w http.ResponseWriter, r *http.Request) {
		if r.Method != http.MethodPost {
			http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
			return
		}
		if err := r.ParseMultipartForm(15 << 20); err != nil {
			writeJSON(w, 400, map[string]any{"ok": false, "error": "Invalid form upload"})
			return
		}

		memberNo := strings.TrimSpace(r.FormValue("memberNo"))
		channel := strings.TrimSpace(r.FormValue("channel")) // "email" | "whatsapp" | "both"
		email := strings.TrimSpace(r.FormValue("email"))
		whatsapp := strings.TrimSpace(r.FormValue("whatsapp"))

		file, _, err := r.FormFile("statement")
		if err != nil {
			writeJSON(w, 400, map[string]any{"ok": false, "error": "Statement PDF is required"})
			return
		}
		defer file.Close()
		rawPDF, _ := io.ReadAll(file)

		// 1. Read PDF & Validate against entered NSSF Member Number
		meta, err := ExtractAndValidatePDF(rawPDF, memberNo)
		if err != nil {
			_ = InsertAuditLog(memberNo, "UNKNOWN", channel, email+"/"+whatsapp, "-", "VALIDATION_FAILED")
			writeJSON(w, 422, map[string]any{"ok": false, "error": err.Error()})
			return
		}

		// 2. Password protect PDF using member's National ID Card No
		encryptedPDF, err := EncryptPDFWithPassword(rawPDF, meta.IDCardNo)
		if err != nil {
			writeJSON(w, 500, map[string]any{"ok": false, "error": "Failed to encrypt statement PDF"})
			return
		}

		// 3. Rename file to official NSSF convention
		renamedFile := fmt.Sprintf("NSSF_Statement_%s_%s.pdf", meta.MemberNo, time.Now().Format("20060102"))
		cfg, _ := GetSettings()

		if channel == "email" || channel == "both" {
			if err := SendEmailStatement(cfg, email, meta, renamedFile, encryptedPDF); err != nil {
				_ = InsertAuditLog(meta.MemberNo, meta.MemberName, "EMAIL", email, renamedFile, "FAILED: "+err.Error())
				writeJSON(w, 502, map[string]any{"ok": false, "error": "Email error: " + err.Error()})
				return
			}
			_ = InsertAuditLog(meta.MemberNo, meta.MemberName, "EMAIL", email, renamedFile, "SENT")
		}

		if channel == "whatsapp" || channel == "both" {
			if err := SendWhatsAppStatement(cfg, whatsapp, meta, renamedFile, encryptedPDF); err != nil {
				_ = InsertAuditLog(meta.MemberNo, meta.MemberName, "WHATSAPP", whatsapp, renamedFile, "FAILED: "+err.Error())
				writeJSON(w, 502, map[string]any{"ok": false, "error": "WhatsApp error: " + err.Error()})
				return
			}
			_ = InsertAuditLog(meta.MemberNo, meta.MemberName, "WHATSAPP", whatsapp, renamedFile, "SENT")
		}

		writeJSON(w, 200, map[string]any{
			"ok":          true,
			"memberNo":    meta.MemberNo,
			"memberName":  meta.MemberName,
			"period":      meta.Period,
			"totalAmount": meta.TotalAmt,
			"renamedFile": renamedFile,
			"channel":     channel,
			"destination": strings.Trim(email+" "+whatsapp, " "),
			"timestamp":   time.Now().Format("02 Jan 2006 15:04:05"),
		})
	})

	// Settings Endpoint
	mux.HandleFunc("/api/settings", func(w http.ResponseWriter, r *http.Request) {
		if r.Method == http.MethodGet {
			cfg, _ := GetSettings()
			writeJSON(w, 200, cfg)
			return
		}
		if r.Method == http.MethodPost {
			var cfg AppSettings
			if err := json.NewDecoder(r.Body).Decode(&cfg); err != nil {
				http.Error(w, err.Error(), 400)
				return
			}
			_ = SaveSettings(cfg)
			writeJSON(w, 200, map[string]any{"ok": true})
		}
	})

	// WhatsApp QR Code Fetch Endpoint
	mux.HandleFunc("/api/whatsapp/qr", func(w http.ResponseWriter, r *http.Request) {
		cfg, _ := GetSettings()
		resp, err := http.Get(cfg.WhatsAppBridge + "/qr")
		if err != nil {
			// Return deterministic fallback SVG QR indicator when bridge is offline
			svg := `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
				<rect width="200" height="200" fill="#ffffff"/>
				<rect x="15" y="15" width="50" height="50" fill="none" stroke="#006837" stroke-width="8"/>
				<rect x="28" y="28" width="24" height="24" fill="#006837"/>
				<rect x="135" y="15" width="50" height="50" fill="none" stroke="#006837" stroke-width="8"/>
				<rect x="148" y="28" width="24" height="24" fill="#006837"/>
				<rect x="15" y="135" width="50" height="50" fill="none" stroke="#006837" stroke-width="8"/>
				<rect x="28" y="148" width="24" height="24" fill="#006837"/>
				<text x="100" y="105" font-size="11" text-anchor="middle" fill="#111827" font-family="monospace">NSSF-WA-LINK</text>
			</svg>`
			writeJSON(w, 200, map[string]any{"paired": cfg.WhatsAppPaired, "qrSvg": svg})
			return
		}
		defer resp.Body.Close()
		io.Copy(w, resp.Body)
	})

	// Audit Logs Endpoint
	mux.HandleFunc("/api/audit", func(w http.ResponseWriter, r *http.Request) {
		logs, _ := GetAuditLogs()
		writeJSON(w, 200, logs)
	})

	// Serve Embedded React SPA
	distFS, _ := fs.Sub(embeddedFrontend, "dist")
	mux.Handle("/", http.FileServer(http.FS(distFS)))

	log.Println("NSSF Statement Dispatch Portal running on http://localhost:8080")
	log.Fatal(http.ListenAndServe(":8080", mux))
}

func writeJSON(w http.ResponseWriter, status int, data any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(data)
}

