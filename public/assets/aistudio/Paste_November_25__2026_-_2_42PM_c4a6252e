func SendEmailStatement(cfg AppSettings, recipient string, meta *StatementMeta, renamedFile string, encryptedPDF []byte) error {
	if !cfg.EmailEnabled {
		return fmt.Errorf("email dispatch is currently disabled in system settings")
	}

	subject, htmlBody, _ := BuildOfficialNSSFMessage(meta, renamedFile)

	var buf bytes.Buffer
	writer := multipart.NewWriter(&buf)

	headers := map[string]string{
		"From":         cfg.SMTPFrom,
		"To":           recipient,
		"Subject":      subject,
		"MIME-Version": "1.0",
		"Content-Type": fmt.Sprintf("multipart/mixed; boundary=%s", writer.Boundary()),
	}
	for k, v := range headers {
		fmt.Fprintf(&buf, "%s: %s\r\n", k, v)
	}
	buf.WriteString("\r\n")

	// HTML Body Part
	htmlHeader := textproto.MIMEHeader{}
	htmlHeader.Set("Content-Type", "text/html; charset=UTF-8")
	htmlPart, _ := writer.CreatePart(htmlHeader)
	htmlPart.Write([]byte(htmlBody))

	// Encrypted PDF Attachment Part
	pdfHeader := textproto.MIMEHeader{}
	pdfHeader.Set("Content-Type", fmt.Sprintf("application/pdf; name=\"%s\"", renamedFile))
	pdfHeader.Set("Content-Disposition", fmt.Sprintf("attachment; filename=\"%s\"", renamedFile))
	pdfHeader.Set("Content-Transfer-Encoding", "base64")
	pdfPart, _ := writer.CreatePart(pdfHeader)

	b64 := base64.StdEncoding.EncodeToString(encryptedPDF)
	for i := 0; i < len(b64); i += 76 {
		end := i + 76
		if end > len(b64) {
			end = len(b64)
		}
		pdfPart.Write([]byte(b64[i:end] + "\r\n"))
	}
	writer.Close()

	auth := smtp.PlainAuth("", cfg.SMTPUser, cfg.SMTPPass, cfg.SMTPHost)
	addr := fmt.Sprintf("%s:%s", cfg.SMTPHost, cfg.SMTPPort)
	return smtp.SendMail(addr, auth, cfg.SMTPUser, []string{recipient}, buf.Bytes())
}

func SendWhatsAppStatement(cfg AppSettings, phone string, meta *StatementMeta, renamedFile string, encryptedPDF []byte) error {
	if !cfg.WhatsAppEnabled {
		return fmt.Errorf("WhatsApp dispatch is currently disabled in system settings")
	}
	_, _, caption := BuildOfficialNSSFMessage(meta, renamedFile)

	payload := fmt.Sprintf(`{"phone":%q,"filename":%q,"caption":%q,"documentBase64":%q}`,
		phone, renamedFile, caption, base64.StdEncoding.EncodeToString(encryptedPDF))

	client := &http.Client{Timeout: 20 * time.Second}
	resp, err := client.Post(cfg.WhatsAppBridge+"/send-document", "application/json", bytes.NewBufferString(payload))
	if err != nil {
		return fmt.Errorf("WhatsApp bridge unreachable: %w", err)
	}
	defer resp.Body.Close()
	if resp.StatusCode >= 300 {
		return fmt.Errorf("WhatsApp dispatch failed with status %d", resp.StatusCode)
	}
	return nil
}

