{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "dev:go": "cd go && (test -f go.sum || go mod tidy) && PORT=8080 go run ./cmd/server",
    "start": "cd go && (test -f go.sum || go mod tidy) && PORT=3000 go run ./cmd/server",
    "build": "vite build",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "clean": "rm -rf dist go/cmd/server/dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
