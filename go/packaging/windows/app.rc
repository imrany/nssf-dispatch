#ifndef APP_VER_CSV
#define APP_VER_CSV 1,0,0,0
#endif

#ifndef APP_VER_RAW
#define APP_VER_RAW 1.0.0.0
#endif

#define NSSF_STR(x) #x
#define NSSF_XSTR(x) NSSF_STR(x)

1 ICON "nssf.ico"

1 VERSIONINFO
FILEVERSION     APP_VER_CSV
PRODUCTVERSION  APP_VER_CSV
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "National Social Security Fund (NSSF) Kenya"
            VALUE "FileDescription",  "NSSF Digital Statement Dispatcher"
            VALUE "FileVersion",      NSSF_XSTR(APP_VER_RAW)
            VALUE "InternalName",     "nssf-dispatch"
            VALUE "LegalCopyright",   "Copyright (C) 2026 National Social Security Fund (NSSF) Kenya. All rights reserved."
            VALUE "OriginalFilename", "NSSF-Statement-Dispatch-windows-amd64.exe"
            VALUE "ProductName",      "NSSF Digital Statement Dispatcher"
            VALUE "ProductVersion",   NSSF_XSTR(APP_VER_RAW)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
